# Copy to .env and replace the values. .env is git-ignored.
# Oracle requires 8+ characters with upper case, lower case and a digit
# (Autonomous AI Database: 12-30 characters, no double quote).
# The admin password: SYS on the Free container (which reads the same variable), ADMIN on
# Autonomous AI Database. Only dbinit and the admin tests use it; the app runs without it.
ORACLE_PWD=ChangeMe_Oracle_2026
# ORACLE_ADMIN_USER=admin   # Autonomous AI Database only (default: sys, as SYSDBA)
# The HR and TDA_MEMORY schema users the app connects as.
TDA_APP_PASSWORD=ChangeMe_App_2026
TDA_END_USER_PASSWORD=ChangeMe_EndUser_2026
# The API's demo token (make api, make demo, docker compose --profile app). Empty: the API answers 503
# and make demo refuses to start. Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
TDA_DEMO_TOKEN=
# Local only, never on a public demo: lets an approved write commit in config C.
# TDA_DEMO_WRITES=1
